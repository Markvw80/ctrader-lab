# Copy to .env and fill in. Never commit .env.

# --- cTrader Open API (phase 6) ---
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCOUNT_ID=
# demo | live. Any future order layer refuses to run unless this is "demo".
CTRADER_ENV=demo

# --- Container ---
CTLAB_WEB_PORT=8088
CTLAB_MEM_LIMIT=2g
CTLAB_CPUS=2
# Host user that owns /volume1/docker/ctrader-lab (check with `id` on the NAS)
PUID=1000
PGID=1000
TZ=UTC
